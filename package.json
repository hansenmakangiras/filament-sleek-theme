{
  "name": "filament-sleek-theme",
  "version": "1.0.0",
  "description": "A modern, sleek, responsive, and customizable theme for FilamentPHP v4 & v5",
  "license": "MIT",
  "author": "Hansen Makangiras <hansenmakangiras@gmail.com>",
  "homepage": "https://github.com/hansenmakangiras/filament-sleek-theme",
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i resources/css/theme.css -o resources/dist/theme.css --minify",
    "dev": "tailwindcss -i resources/css/theme.css -o resources/dist/theme.css --watch",
    "format": "prettier --write \"resources/css/**/*.css\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.3"
  }
}
