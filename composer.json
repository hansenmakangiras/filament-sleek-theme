{
    "name": "resma/filament-awin-theme",
    "description": "A modern, responsive, and customizable theme for FilamentPHP, designed to elevate your admin panel with a sleek interface and seamless user experience.",
    "keywords": [
        "Resma",
        "laravel",
        "filamentphp",
        "filament-awin-theme",
        "theme",
        "filament"
    ],
    "homepage": "https://github.com/resmatech/filament-awin-theme",
    "support": {
        "issues": "https://github.com/resmatech/filament-awin-theme/issues",
        "source": "https://github.com/resmatech/filament-awin-theme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Rebwar Mustafa",
            "email": "hello@resma.tech",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "filament/filament": "^4.0|^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Resma\\FilamentAwinTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Resma\\FilamentAwinTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Resma\\FilamentAwinTheme\\FilamentAwinThemeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
