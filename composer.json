{
    "name": "hansenmakangiras/filament-sleek-theme",
    "description": "A modern, sleek, responsive, and customizable theme for FilamentPHP v4 & v5.",
    "keywords": [
        "hansenmakangiras",
        "laravel",
        "filamentphp",
        "filament-sleek-theme",
        "theme",
        "filament",
        "sleek"
    ],
    "homepage": "https://github.com/hansenmakangiras/filament-sleek-theme",
    "support": {
        "issues": "https://github.com/hansenmakangiras/filament-sleek-theme/issues",
        "source": "https://github.com/hansenmakangiras/filament-sleek-theme"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Hansen Makangiras",
            "email": "hansenmakangiras@gmail.com",
            "role": "Maintainer"
        },
        {
            "name": "Rebwar Mustafa",
            "email": "hello@resma.tech",
            "role": "Original Author"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "HansenMakangiras\\FilamentSleekTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HansenMakangiras\\FilamentSleekTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint --parallel",
        "test": "pest --parallel",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HansenMakangiras\\FilamentSleekTheme\\FilamentSleekThemeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
